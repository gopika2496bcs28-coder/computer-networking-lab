#include <stdio.h>
#include <string.h>
void sender()
{
    char data[100];
    int ones = 0, parity, choice;
    int i;
    printf("\n--- Sender Side ---\n");
    printf("Enter data bits: ");
    scanf("%s", data);
    printf("\nChoose Parity Type");
    printf("\n1. Even Parity");
    printf("\n2. Odd Parity");
    printf("\nEnter choice: ");
    scanf("%d", &choice);
    for(i = 0; data[i] != '\0'; i++)
    {
        if(data[i] == '1')
            ones++;
    }
    if(choice == 1)
        parity = (ones % 2 == 0) ? 0 : 1;
    else
        parity = (ones % 2 == 0) ? 1 : 0;
    printf("\nGenerated Parity Bit: %d", parity);
    printf("\nTransmitted Frame: %s%d\n", data, parity);
}
void receiver()
{
    char received[100];
    int ones = 0, choice;
    int i;
    printf("\n--- Receiver Side ---\n");
    printf("Enter received frame: ");
    scanf("%s", received);
    for(i = 0; received[i] != '\0'; i++)
    {
        if(received[i] == '1')
            ones++;
    }
    printf("\nChoose Parity Type");
    printf("\n1. Even Parity");
    printf("\n2. Odd Parity");
    printf("\nEnter choice: ");
    scanf("%d", &choice);
    if((choice == 1 && ones % 2 == 0) ||
       (choice == 2 && ones % 2 != 0))
        printf("\nNo Error Detected\n");
    else
        printf("\nError Detected\n");
}
int main()
{
    int choice;
    while(1)
    {
        printf("\n\n***** PARITY ERROR DETECTION *****");
        printf("\n1. Sender Side");
        printf("\n2. Receiver Side");
        printf("\n3. Exit");
        printf("\nEnter choice: ");
        scanf("%d",&choice);
        switch(choice)
        {
            case 1:
                sender();
                break;

            case 2:
                receiver();
                break;

            case 3:
                return 0;

            default:
                printf("Invalid Choice");
        }
    }
    return 0;
}

